---
import '../styles/style.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
}

const { title, description, keywords = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Tereshkova Engenharia">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <link rel="canonical" href="https://tereshkovaengenharia.com.br" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <title>{title} | Tereshkova Engenharia</title>
</head>
<body>
  <slot />
  <a href="https://wa.me/556992158799" target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Fale conosco pelo WhatsApp">
    <i class="fab fa-whatsapp"></i>
  </a>
  <script is:inline src="/js/script.js"></script>
</body>
</html>
