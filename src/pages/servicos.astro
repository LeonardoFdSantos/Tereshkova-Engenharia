---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout
  title="Serviços | Tereshkova Engenharia"
  description="Conheça todos os serviços de engenharia elétrica oferecidos pela Tereshkova Engenharia: projetos, automação, manutenção e laudos."
  keywords="serviços engenharia elétrica, projetos elétricos, automação industrial, manutenção elétrica, laudos técnicos"
>
  <Header />

  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <span class="hero-badge">
          <i class="fas fa-cogs"></i> Nossas Soluções
        </span>
        <h1 class="page-title">Serviços de <span class="editorial-title">Excelência</span></h1>
        <p class="page-subtitle">Soluções completas e integradas em engenharia elétrica para todos os segmentos.</p>
      </div>
    </section>

    <!-- Services Detail Section -->
    <section class="section">
      <div class="container">
        <div class="text-center mb-xl">
          <h2 class="section-title mt-xs">Engenharia com <span class="editorial-title">Precisão Absoluta</span></h2>
          <p class="section-subtitle">Conheça detalhadamente cada uma de nossas especialidades técnicas.</p>
        </div>

        <div class="services-list">
          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-drafting-compass"></i></div>
              <h3 class="service-detail-title">Projetos Elétricos Residenciais e Comerciais</h3>
            </div>
            <p class="service-detail-description">
              Desenvolvimento completo de projetos de instalações elétricas de baixa tensão, dimensionamento de cargas, sistemas de aterramento e proteção contra descargas atmosféricas (SPDA), garantindo eficiência e segurança.
            </p>
          </article>

          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-industry"></i></div>
              <h3 class="service-detail-title">Projetos Industriais e Subestações</h3>
            </div>
            <p class="service-detail-description">
              Projetos de média e alta tensão, subestações transformadoras, estudos de coordenação e seletividade de proteção, correção de fator de potência e adequação às normativas vigentes.
            </p>
          </article>

          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-cogs"></i></div>
              <h3 class="service-detail-title">Automação e Painéis Elétricos</h3>
            </div>
            <p class="service-detail-description">
              Montagem de painéis elétricos (QGBT, comandos e automação), programação de CLPs, inversores de frequência e integração de sistemas para máxima eficiência produtiva industrial.
            </p>
          </article>

          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-tools"></i></div>
              <h3 class="service-detail-title">Manutenção Preventiva e Corretiva</h3>
            </div>
            <p class="service-detail-description">
              Serviços especializados de manutenção em instalações elétricas, termografia, testes de isolamento e atendimento rápido a chamados corretivos para garantir continuidade operacional.
            </p>
          </article>

          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-solar-panel"></i></div>
              <h3 class="service-detail-title">Energia Solar Fotovoltaica</h3>
            </div>
            <p class="service-detail-description">
              Projetos e instalação de sistemas de geração de energia solar fotovoltaica para residências, comércios e indústrias, proporcionando economia expressiva na conta de luz e sustentabilidade.
            </p>
          </article>

          <article class="service-detail-card glass-card">
            <div class="service-detail-header">
              <div class="service-detail-icon"><i class="fas fa-file-contract"></i></div>
              <h3 class="service-detail-title">Laudos Técnicos e Vistorias (NR-10)</h3>
            </div>
            <p class="service-detail-description">
              Emissão de laudos técnicos, prontuários de instalações elétricas conforme NR-10, laudos de SPDA e realização de medições para atestar segurança e conformidade legal.
            </p>
          </article>
        </div>

        <!-- CTA Inside Services -->
        <CtaSection
          title="Precisa de um projeto personalizado?"
          subtitle="Fale agora com nossos engenheiros especialistas pelo WhatsApp e tire suas dúvidas."
          buttonText="Fale no WhatsApp"
          buttonLink="https://wa.me/556992158799"
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
