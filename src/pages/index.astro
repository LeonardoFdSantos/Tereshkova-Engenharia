---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout
  title="Tereshkova Engenharia | Soluções em Engenharia Elétrica"
  description="Empresa especializada em projetos, automação e manutenção elétrica com padrão de excelência e design imersivo."
  keywords="engenharia elétrica, projetos elétricos, automação, manutenção elétrica, laudos técnicos, Santa Maria"
>
  <Header />

  <main>
    <!-- Hero Section: Imersivo & Editorial -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge">
          <i class="fas fa-bolt"></i> Excelência em Engenharia Elétrica
        </div>
        <h1 class="hero-title">
          Construindo o <span class="editorial-title">Futuro</span> com Precisão e Inovação
        </h1>
        <p class="hero-subtitle">
          Soluções avançadas em projetos, automação e manutenção elétrica para o setor residencial, comercial e industrial.
        </p>
        <div class="hero-buttons">
          <a href="https://wa.me/556992158799" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large">
            <i class="fab fa-whatsapp" style="margin-right: 8px;"></i> Falar no WhatsApp
          </a>
          <a href="/servicos" class="btn btn-outline btn-large">Nossos Serviços</a>
        </div>
      </div>
    </section>

    <!-- Services Featured Section -->
    <section class="section services-featured">
      <div class="container">
        <div class="text-center mb-xl">
          <span class="text-secondary text-sm font-semibold uppercase tracking-wider">O que fazemos</span>
          <h2 class="section-title mt-xs">Engenharia de <span class="editorial-title">Alto Padrão</span></h2>
          <p class="section-subtitle">Combinamos rigor técnico e inovação para entregar projetos seguros, eficientes e sob medida.</p>
        </div>

        <div class="services-grid">
          <ServiceCard
            icon="fas fa-drafting-compass"
            title="Projetos Elétricos"
            description="Elaboração de projetos residenciais, comerciais e industriais em total conformidade com as normas técnicas vigentes."
            link="/servicos"
          />
          <ServiceCard
            icon="fas fa-cogs"
            title="Automação Industrial"
            description="Sistemas automatizados inteligentes para otimização de processos, aumento de produtividade e segurança operacional."
            link="/servicos"
          />
          <ServiceCard
            icon="fas fa-tools"
            title="Manutenção Preventiva"
            description="Inspeções detalhadas, testes em equipamentos e manutenções programadas para evitar paradas não planejadas."
            link="/servicos"
          />
        </div>
      </div>
    </section>

    <!-- Why Choose Us / Immersive Section -->
    <section class="section why-choose-section">
      <div class="container why-choose-container">
        <div class="why-choose-image card-zoom">
          <img src="/images/obra-concluida.jpg" alt="Obra concluída pela Tereshkova Engenharia">
        </div>
        <div class="why-choose-content">
          <span class="text-secondary text-sm font-semibold uppercase tracking-wider">Por que nos escolher</span>
          <h2 class="section-title">Compromisso absoluto com a <span class="editorial-title">Qualidade</span></h2>
          <p class="why-choose-text">
            Nossa equipe de engenheiros altamente qualificados garante que cada etapa do seu projeto seja executada com precisão cirúrgica, segurança inegociável e cumprimento rigoroso de prazos.
          </p>
          <ul class="differentials-list">
            <li class="differential-item"><i class="fas fa-check-circle"></i> Equipe técnica certificada e experiente</li>
            <li class="differential-item"><i class="fas fa-check-circle"></i> Rigoroso cumprimento de prazos e normas ABNT</li>
            <li class="differential-item"><i class="fas fa-check-circle"></i> Atendimento consultivo e personalizado</li>
          </ul>
          <a href="/sobre" class="btn btn-primary">Conheça Nossa História</a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <CtaSection
      title="Precisa de um Orçamento Imediato?"
      subtitle="Fale diretamente com nossa equipe técnica via WhatsApp e receba atendimento especializado."
      buttonText="Falar no WhatsApp ((69) 9215-8799)"
      buttonLink="https://wa.me/556992158799"
    />
  </main>

  <Footer />
</BaseLayout>
