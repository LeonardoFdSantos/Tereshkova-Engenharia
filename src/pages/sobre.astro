---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout
  title="Sobre | Tereshkova Engenharia"
  description="Conheça a história, missão, visão e valores da Tereshkova Engenharia, empresa especializada em engenharia elétrica com padrão de excelência."
  keywords="sobre Tereshkova Engenharia, história, missão, visão, valores, engenharia elétrica Santa Maria"
>
  <Header />

  <main>
    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <span class="hero-badge">
          <i class="fas fa-info-circle"></i> Nossa História
        </span>
        <h1 class="page-title">Conheça a <span class="editorial-title">Tereshkova</span></h1>
        <p class="page-subtitle">Tradição, inovação e compromisso com a excelência em engenharia elétrica.</p>
      </div>
    </section>

    <!-- History Section -->
    <section class="section">
      <div class="container history-container">
        <div class="history-content">
          <h2 class="section-title mt-xs">Mais de uma década de <span class="editorial-title">Inovação</span></h2>
          <p class="history-text">
            Fundada com o propósito de elevar os padrões de engenharia elétrica em Santa Maria e região, a Tereshkova Engenharia se destacou por sua abordagem técnica impecável e soluções sob medida para cada cliente. Ao longo dos anos, construímos uma reputação baseada na confiança, qualidade e inovação constante.
          </p>
          <p class="history-text">
            Nosso nome é uma homenagem à primeira mulher a ir ao espaço, Valentina Tereshkova, simbolizando nossa busca por ultrapassar limites e alcançar novos patamares de excelência em cada projeto que entregamos.
          </p>
          <a href="https://wa.me/5555992158799" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-large mt-lg">
            <i class="fab fa-whatsapp" style="margin-right: 8px;"></i> Fale no WhatsApp
          </a>
        </div>
        <div class="history-image card-zoom">
          <img src={`${base}/images/engenheira-industrial.avif`} alt="Engenheira industrial - Tereshkova Engenharia">
        </div>
      </div>
    </section>

    <!-- MVV Section -->
    <section class="section" style="background-color: var(--bg-light);">
      <div class="container">
        <div class="text-center mb-xl">
          <h2 class="section-title mt-xs">Missão, Visão e <span class="editorial-title">Valores</span></h2>
        </div>
        <div class="mvv-grid">
          <div class="mvv-card glass-card">
            <div class="mvv-icon"><i class="fas fa-target"></i></div>
            <h3 class="mvv-title">Missão</h3>
            <p class="mvv-description">Entregar soluções em engenharia elétrica com máxima eficiência, segurança e inovação, superando as expectativas dos nossos clientes.</p>
          </div>
          <div class="mvv-card glass-card">
            <div class="mvv-icon"><i class="fas fa-eye"></i></div>
            <h3 class="mvv-title">Visão</h3>
            <p class="mvv-description">Ser referência nacional em engenharia elétrica, reconhecida pela excelência técnica e compromisso com o desenvolvimento sustentável.</p>
          </div>
          <div class="mvv-card glass-card">
            <div class="mvv-icon"><i class="fas fa-heart"></i></div>
            <h3 class="mvv-title">Valores</h3>
            <p class="mvv-description">Ética, transparência, qualidade técnica, inovação contínua e respeito ao meio ambiente e às pessoas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Differentiators Section -->
    <section class="section">
      <div class="container">
        <div class="text-center mb-xl">
          <h2 class="section-title mt-xs">O que nos <span class="editorial-title">Diferencia</span></h2>
        </div>
        <div class="differentiators-grid">
          <div class="differentiator-card glass-card">
            <div class="differentiator-icon"><i class="fas fa-users"></i></div>
            <h3 class="differentiator-title">Equipe Especializada</h3>
            <p class="differentiator-text">Engenheiros e técnicos altamente qualificados com certificações e experiência comprovada no setor.</p>
          </div>
          <div class="differentiator-card glass-card">
            <div class="differentiator-icon"><i class="fas fa-certificate"></i></div>
            <h3 class="differentiator-title">Conformidade Total</h3>
            <p class="differentiator-text">Todos os nossos projetos seguem rigorosamente as normas ABNT, NR-10 e regulamentações locais.</p>
          </div>
          <div class="differentiator-card glass-card">
            <div class="differentiator-icon"><i class="fas fa-shield-alt"></i></div>
            <h3 class="differentiator-title">Segurança Acima de Tudo</h3>
            <p class="differentiator-text">Implementamos protocolos de segurança rigorosos em todas as etapas, da concepção à execução.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <CtaSection
      title="Pronto para transformar seu projeto?"
      subtitle="Conte com nossa expertise para levar sua instalação elétrica a um novo patamar de qualidade e eficiência."
      buttonText="Fale no WhatsApp"
      buttonLink="https://wa.me/5555992158799"
    />
  </main>

  <Footer />
</BaseLayout>
