---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<footer class="footer">
  <div class="container footer-container">
    <!-- Company Column -->
    <div class="footer-column">
      <a href={base} class="footer-logo">
        <img src={`${base}images/logo.png`} alt="Tereshkova Engenharia Logo" class="footer-logo-img">
        <span class="footer-logo-text">Tereshkova<br>Engenharia</span>
      </a>
      <p class="footer-description">
        Especialistas em engenharia elétrica com soluções inovadoras e seguras.
      </p>
      <div class="footer-social">
        <a href="#" class="social-link" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        <a href="#" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" class="social-link" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      </div>
    </div>

    <!-- Quick Links Column -->
    <div class="footer-column">
      <h4 class="footer-column-title">Links Rápidos</h4>
      <ul class="footer-links">
        <li><a href={base} class="footer-link">Início</a></li>
        <li><a href={`${cleanBase}/servicos`} class="footer-link">Serviços</a></li>
        <li><a href={`${cleanBase}/sobre`} class="footer-link">Sobre</a></li>
        <li><a href={`${cleanBase}/contato`} class="footer-link">Contato</a></li>
      </ul>
    </div>

    <!-- Contact Column -->
    <div class="footer-column">
      <h4 class="footer-column-title">Contato</h4>
      <ul class="footer-contact">
        <li class="footer-contact-item"><i class="fas fa-phone"></i> (69) 99215-8799 / (55) 99642-7551</li>
        <li class="footer-contact-item"><i class="fas fa-mobile-alt"></i> (69) 99215-8799 / (55) 99642-7551</li>
        <li class="footer-contact-item"><i class="fas fa-envelope"></i> tereshkova.engenharia@gmail.com</li>
        <li class="footer-contact-item"><i class="fas fa-map-marker-alt"></i> Rua João da Fontoura e Souza, 215, Camobi — Santa Maria/RS</li>
      </ul>
      <div class="footer-social">
        <a href="#" class="social-link" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        <a href="#" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" class="social-link" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <p class="copyright">&copy; {new Date().getFullYear()} Tereshkova Engenharia. Todos os direitos reservados.</p>
      <p class="developed-by">Desenvolvido por Leonardo Felipe da Silva dos Santos</p>
    </div>
  </div>
</footer>
