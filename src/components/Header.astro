---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">
      <img src="/images/logo.png" alt="Tereshkova Engenharia Logo" class="logo-img">
      <span class="logo-text">TERESHKOVA<br>ENGENHARIA</span>
    </a>
    <nav class="navbar">
      <ul class="nav-links">
        <li><a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Início</a></li>
        <li><a href="/servicos" class={`nav-link ${currentPath === '/servicos' || currentPath.startsWith('/servicos') ? 'active' : ''}`}>Serviços</a></li>
        <li><a href="/sobre" class={`nav-link ${currentPath === '/sobre' ? 'active' : ''}`}>Sobre</a></li>
        <li><a href="/contato" class={`nav-link ${currentPath === '/contato' ? 'active' : ''}`}>Contato</a></li>
      </ul>
      <a href="/contato#formulario" class="btn btn-primary">Solicite Orçamento</a>
    </nav>
    <button class="hamburger" id="hamburger-btn" aria-label="Menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-nav">
    <ul class="mobile-nav-links">
      <li><a href="/" class="mobile-nav-link">Início</a></li>
      <li><a href="/servicos" class="mobile-nav-link">Serviços</a></li>
      <li><a href="/sobre" class="mobile-nav-link">Sobre</a></li>
      <li><a href="/contato" class="mobile-nav-link">Contato</a></li>
      <li><a href="/contato#formulario" class="btn btn-primary mobile-cta">Solicite Orçamento</a></li>
    </ul>
  </nav>
</div>
