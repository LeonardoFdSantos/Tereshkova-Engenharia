---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<header class="header">
  <div class="container header-container">
    <a href={base} class="logo">
      <img src={`${base}images/logo.png`} alt="Tereshkova Engenharia Logo" class="logo-img">
      <span class="logo-text">TERESHKOVA<br>ENGENHARIA</span>
    </a>
    <nav class="navbar">
      <ul class="nav-links">
        <li><a href={base} class={`nav-link ${currentPath === cleanBase || currentPath === cleanBase + '/' || currentPath === '/' ? 'active' : ''}`}>Início</a></li>
        <li><a href={`${cleanBase}/servicos`} class={`nav-link ${currentPath.includes('/servicos') ? 'active' : ''}`}>Serviços</a></li>
        <li><a href={`${cleanBase}/sobre`} class={`nav-link ${currentPath.includes('/sobre') ? 'active' : ''}`}>Sobre</a></li>
        <li><a href={`${cleanBase}/contato`} class={`nav-link ${currentPath.includes('/contato') ? 'active' : ''}`}>Contato</a></li>
      </ul>
      <a href="https://wa.me/5555992158799" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Fale no WhatsApp</a>
    </nav>
    <button class="hamburger" id="hamburger-btn" aria-label="Menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-nav">
    <ul class="mobile-nav-links">
      <li><a href={base} class="mobile-nav-link">Início</a></li>
      <li><a href={`${cleanBase}/servicos`} class="mobile-nav-link">Serviços</a></li>
      <li><a href={`${cleanBase}/sobre`} class="mobile-nav-link">Sobre</a></li>
      <li><a href={`${cleanBase}/contato`} class="mobile-nav-link">Contato</a></li>
      <li><a href="https://wa.me/5555992158799" target="_blank" rel="noopener noreferrer" class="btn btn-primary mobile-cta">Fale no WhatsApp</a></li>
    </ul>
  </nav>
</div>
